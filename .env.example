# ElevenLabs API key for the voice-over and music.
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
# Optional: a voice id per language (VOICE_<LANG>, from ElevenLabs → Voices)
# and a model id. Shared by every project in this folder.
# VOICE_EN=
# VOICE_ID=
# TTS_MODEL=

FAL_API_KEY=YOUR_FAL_API_KEY

# --- Insights (node shared/cloud.mjs account) ---

# AdMob Network Report (Krida publisher). Needs a Google Cloud OAuth *desktop*
# client with the AdMob API enabled. Redirect URI:
#   http://127.0.0.1:8765/oauth2/callback
# Then: node shared/cloud.mjs admob-login
# ADMOB_PUBLISHER_ID=pub-4887874546732768
# ADMOB_OAUTH_CLIENT_ID=
# ADMOB_OAUTH_CLIENT_SECRET=
# ADMOB_OAUTH_PORT=8765

# App Store Connect (Sales). Key is a .p8 from Users and Access → Keys.
# ASC_ISSUER_ID=
# ASC_KEY_ID=
# ASC_PRIVATE_KEY_PATH=path/to/AuthKey_XXX.p8
# ASC_VENDOR_NUMBER=
# ASC_APP_IDS=

# Google Play (service account linked in Play Console → API access).
# PLAY_SERVICE_ACCOUNT_JSON=path/to/play-service-account.json
# PLAY_PACKAGE_NAMES=com.ardeman.krida
# Optional GCS bucket with Play financial earnings CSVs:
# PLAY_EARNINGS_BUCKET=
