# Local secrets; keep the setup template tracked.
.env
.env.*
!.env.example
.secrets/
*.p8
*.pem
*.key
*service-account*.json

# Dependencies and local system files.
node_modules
.DS_Store
*.log

# Local scratch (clones, one-off dumps).
.tmp/

# Generated media and paid audio and picture caches. Keep caches on disk for re-renders.
audio/
art/
out/
shots/
krida/promo/clips/*
!krida/promo/clips/.gitkeep


# Spending logs, written by shared/.
usage.jsonl
fal-usage.jsonl

# Marketing plans live in Firestore; this is the copy `node shared/cloud.mjs pull` writes.
*/marketing-plan.md

# Firebase CLI deploy cache.
.firebase/

# Krida store screenshot editor (Next.js)
store-screenshots/.next/
store-screenshots/.e2e/
store-screenshots/*.tsbuildinfo
store-screenshots/next-env.d.ts
store-screenshots/.env*.local
