rules_version = '2';
// Only the owner's Google account; shared/cloud.mjs writes with gcloud, past these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null
        && request.auth.token.email == 'are.theman@gmail.com'
        && request.auth.token.email_verified;
    }
    // Each rule that matches can grant access, so no wildcard: it would let
    // the page change versions too.
    match /projects/{id} {
      allow read, write: if owner();
    }
    match /projects/{id}/posts/{post} {
      allow read, write: if owner();
    }
    // Old plans (shared/cloud.mjs push and the page's saves): kept, never changed.
    match /projects/{id}/versions/{version} {
      allow read, create: if owner();
    }
    // The credits and paid calls (shared/cloud.mjs, cloud/render.mjs): read only.
    match /dashboard/{id} {
      allow read: if owner();
    }
    // Render requests (cloud/render.mjs): the page asks and approves a price;
    // only the job (past these rules) sets the rest.
    match /renders/{id} {
      allow read: if owner();
      allow create: if owner()
        && request.resource.data.keys().hasOnly(['project', 'action', 'args', 'status', 'createdAt'])
        && request.resource.data.status == 'requested';
      allow update: if owner()
        && resource.data.status == 'priced'
        && request.resource.data.status == 'approved'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt']);
    }
  }
}
